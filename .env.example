# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start in production while this is the development default.
SESSION_SECRET=replace-with-a-long-secret

DATABASE_PATH=./backend/data/hanoi-local.sqlite

# How long a session stays valid without activity.
SESSION_TTL_DAYS=7

NODE_ENV=development
