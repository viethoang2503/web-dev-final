# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

DATABASE_PATH=./source/backend/data/hanoi-local.sqlite
NODE_ENV=development

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Email admin, cách nhau bằng dấu phẩy. Tài khoản có email này tự thành admin khi đăng nhập.
ADMIN_EMAILS=
# Tùy chọn: địa chỉ công khai của site cho mã QR thanh toán, ví dụ http://192.168.1.10:3000
PUBLIC_URL=
